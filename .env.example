# Node Environment
NODE_ENV=production
PORT=3001

# CORS Allowed Origins (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173

# Frontend API URL (for production deployments where frontend and backend are hosted on different domains)
VITE_API_URL=http://localhost:3001

# GitHub OAuth App Credentials (for production live OAuth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Session & Security
SESSION_SECRET=
